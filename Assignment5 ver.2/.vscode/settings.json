//   // CSS, SCSS, Less 구문 검증 켜기 (false로 바꾸면 경고 사라짐)
//   "css.validate": true,
//   "scss.validate": true,
//   "less.validate": true,

//   // PostCSS 언어 지원 확장 사용 시 필요할 수도 있는 설정
