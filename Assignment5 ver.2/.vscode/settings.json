{
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "tailwindCSS.experimental.classRegex": ["tw`([^`]*)", "clsx\\(([^)]*)\\)", "classnames\\(([^)]*)\\)"],
  "editor.quickSuggestions": {
    "strings": true
  }
}